generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                  String    @id @default(cuid())
  user_id             String
  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  expires_at          DateTime?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model User {
  id                String    @id @default(cuid())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())
  deleted_at        DateTime?
  status            Int?      @default(1) @db.SmallInt

  email             String?   @unique
  first_name        String?   @db.VarChar(255)
  last_name         String?   @db.VarChar(255)
  password          String?   @db.VarChar(255)
  
  name              String?
  avatar            String?
  approved_at       DateTime?
  phone_number      String?
  address           String?
  availability      String?

  billing_id        String?
  type              String?   @default("user")
  email_verified_at DateTime?

  accounts             Account[]
  payment_transactions PaymentTransaction[]
  subscriptions        Subscription[]
  ucodes               Ucode[]
  roles                RoleUser[]
  
  sent_notifications     Notification[] @relation("NotificationSender")
  received_notifications Notification[] @relation("NotificationReceiver")
  quiz_results           QuizResult[]
  community_messages     CommunityMessage[]
  feedbacks              Feedback[]

  @@map("users")
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id    String?
  token      String?
  email      String?
  expired_at DateTime?
  user       User?    @relation(fields: [user_id], references: [id])

  @@map("ucodes")
}

model PaymentTransaction {
  id               String    @id @default(cuid())
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?
  user_id          String?
  customer_id      String    @default("")
  type             String?   @default("subscription")
  provider         String?   @default("stripe")
  reference_number String?
  status           String?   @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?
  invoice_url      String?
  user             User?     @relation(fields: [user_id], references: [id])

  @@map("payment_transactions")
}

model Subscription {
  id                     String    @id @default(uuid())
  user_id                String
  stripe_customer_id     String
  stripe_subscription_id String    @unique
  status                 String
  plan_type              String
  current_period_start   DateTime
  current_period_end     DateTime
  cancel_at_period_end   Boolean   @default(false)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?
  user                   User      @relation(fields: [user_id], references: [id])

  @@map("subscriptions")
}

model Role {
  id          String           @id @default(cuid())
  name        String?          @unique
  title       String?          @unique
  created_at  DateTime         @default(now())
  updated_at  DateTime         @default(now())
  users       RoleUser[]
  permissions PermissionRole[]

  @@map("roles")
}

model RoleUser {
  id         String   @id @default(cuid())
  role_id    String
  user_id    String
  created_at DateTime @default(now())
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("role_users")
}

model Permission {
  id         String           @id @default(cuid())
  title      String           @unique
  slug       String           @unique
  created_at DateTime         @default(now())
  roles      PermissionRole[]

  @@map("permissions")
}

model PermissionRole {
  id            String     @id @default(cuid())
  role_id       String
  permission_id String
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  
  title         String?

  @@map("permission_roles")
}

model Contact {
  id           String   @id @default(cuid())
  first_name   String?
  last_name    String?
  email        String?
  phone_number String?
  message      String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  @@map("contacts")
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String
  sort_order Int?     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("faqs")
}

model WebsiteInfo {
  id                  String   @id @default(cuid())
  title               String?
  name                String?
  email               String?
  address             String?
  phone_number        String?
  copyright           String?
  logo                String?
  favicon             String?
  cancellation_policy String?  // <-- Lägg till denna rad!
  created_at          DateTime @default(now())

  @@map("website_info")
}

model Message {
  id         String        @id @default(cuid())
  text       String
  status     MessageStatus @default(SENT)
  created_at DateTime      @default(now())

  @@map("messages")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Notification {
  id                    String            @id @default(cuid())
  title                 String            @default("")
  body                  String            @default("")
  sender_id             String?
  receiver_id           String?
  entity_id             String?
  notification_event_id String?
  created_at            DateTime          @default(now())
  
  sender             User?              @relation("NotificationSender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver           User?              @relation("NotificationReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  notification_event NotificationEvent? @relation("NotificationToEvent", fields: [notification_event_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationEvent {
  id           String         @id @default(cuid())
  text         String?
  type         String?
  created_at   DateTime       @default(now())
  Notification Notification[] @relation("NotificationToEvent")

  @@map("notification_events")
}

model QuizResult {
  id                 String   @id @default(cuid())
  user_id            String
  category           String   @default("slutprov")
  category_title     String   @default("Slutprov")
  total_questions    Int      @default(65)
  correct_count      Int      @default(0)
  incorrect_count    Int      @default(0)
  score_percent      Int      @default(0)
  passed             Boolean  @default(false)
  time_spent_sec     Int?     @default(0)
  category_breakdown Json?
  details            Json?
  created_at         DateTime @default(now())
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model CommunityMessage {
  id          String   @id @default(cuid())
  language    String   @default("sv")
  user_id     String?
  user_name   String   @default("Körkortselev")
  user_email  String?
  user_role   String   @default("user")
  topic       String?  @default("Allmänt")
  message     String
  likes_count Int      @default(0)
  parent_id   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([language, created_at])
  @@map("community_messages")
}

model Duel {
  id                   String   @id @default(cuid())
  code                 String   @unique
  game_mode            String   @default("quick") // "quick" (10), "classic" (20), "slutprov" (65)
  creator_id           String?
  creator_name         String   @default("Spelare 1")
  creator_score        Int      @default(0)
  creator_correct      Int      @default(0)
  creator_finished     Boolean  @default(false)
  creator_answers      Json?

  challenger_id        String?
  challenger_name      String?
  challenger_score     Int      @default(0)
  challenger_correct   Int      @default(0)
  challenger_finished  Boolean  @default(false)
  challenger_answers   Json?

  is_vs_ai             Boolean  @default(false)
  ai_difficulty        String?
  status               String   @default("waiting") // "waiting", "active", "completed"
  winner_name          String?
  questions            Json
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt

  @@index([code])
  @@map("duels")
}

model Feedback {
  id          String   @id @default(cuid())
  user_id     String?
  name        String?  @default("Anonym elev")
  email       String?
  rating      Int      @default(5)
  category    String?  @default("allmänt")
  message     String
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@map("feedbacks")
}
